# Copy this file to ".env" and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=5050

# Use 127.0.0.1 (not "localhost"): on Node 18+ "localhost" can resolve to IPv6 (::1)
# while MongoDB only listens on IPv4, which causes ECONNREFUSED.
MONGODB_URI=mongodb://127.0.0.1:27017/wereuse

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters
JWT_EXPIRES_DAYS=7

# Frontend origin(s) allowed to call this API (comma separated)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

BCRYPT_ROUNDS=12
MAX_UPLOAD_MB=5

# Used only by:  npm run seed:admin
ADMIN_NAME=WeReUse Admin
ADMIN_EMAIL=admin@wereuse.com
ADMIN_PASSWORD=Admin@12345
